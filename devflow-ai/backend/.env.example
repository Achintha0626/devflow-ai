##These files contain placeholder values, 
##not  actual passwords or API keys. 
#They help to remember which variables to configure on Render and Vercel.

PORT=5000
NODE_ENV=development
DATABASE_URL=test
REDIS_URL=redis://localhost:6379
ML_SERVICE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_secure_random_string_at_least_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
GEMINI_API_KEY=your_google_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=gemini-1.5-flash
GEMINI_MAX_RETRIES=3
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=20
AUTH_REGISTER_RATE_LIMIT_MAX=20
AUTH_REFRESH_RATE_LIMIT_MAX=60
